	copyright = {arXiv.org perpetual, non-exclusive license},
	shorttitle = {{SpeC2Rust}},
	url = {https://arxiv.org/abs/2610.34141},
	doi = {10.48550/ARXIV.2610.34141},
	abstract = {Legacy C codebases remain central to system software and
	            performance-critical infrastructure, while their weak memory-safety
	            guarantees continue to impose substantial security and maintenance
	            risks. Recent C-to-Rust translation systems, including translators
	            based on large language models (LLMs), have made automated
	            migration increasingly feasible. However, LLM-based translation
	            still faces several challenges. Existing methods often preserve the
	            original C skeleton, making it difficult to recover project intent
	            and module functionalities at repository scale. The translated Rust
	            code may still rely on raw pointers and unsafe constructs.
	            Cross-file interfaces and dependency relations are also difficult
	            to maintain consistently across generated Rust modules. Even when
	            initial translation succeeds, the resulting project still requires
	            costly compilation repair and end-to-end validation, while naively
	            accumulated context during this process can degrade repair
	            stability and efficiency.},
	language = {en},
	urldate = {2026-11-04},
