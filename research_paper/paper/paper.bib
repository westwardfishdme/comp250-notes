@misc{yao_spec2rust_2026,
	title = {{SpeC2Rust}: {Specification}-{Driven} {Repository}-{Level} {C}-to-{
	         Rust} {Translation}},
	shorttitle = {{SpeC2Rust}},
	url = {http://arxiv.org/abs/2610.34141},
	doi = {10.48550/arXiv.2610.34141},
	abstract = {Legacy C codebases remain central to system software and
	            performance-critical infrastructure, but their weak memory safety
	            imposes security and maintenance risks. Recent C-to-Rust
	            translation systems, including LLM-based translators, make
	            automated migration increasingly feasible, yet they still struggle
	            to recover repository-level intent, avoid raw pointers and unsafe
	            constructs, maintain cross-file interfaces, and repair compilation
	            and validation failures efficiently. We propose SpeC2Rust, a
	            specification-driven pipeline for repository-level C-to-Rust
	            translation. It has three stages: (1) Project-Intent Structuring,
	            which decomposes a C repository into semantically coherent modules
	            and generates persistent repository- and module-level
	            specifications; (2) Spec-Guided Generation, which translates each
	            Rust module against these specifications with a live symbol
	            registry to preserve cross-file consistency; and (3)
	            Layered-Feedback Repair, which batches repairs and injects only
	            failure-relevant diagnostics, specification context, and source
	            evidence for efficient compilation and test-driven correction. We
	            evaluate SpeC2Rust on eight repository-level C projects. It
	            generates Rust projects that compile and pass the original
	            end-to-end tests, with no raw-pointer declarations, raw-pointer
	            dereferences, or unsafe lines. On projects shared with an LLM-based
	            baseline, SpeC2Rust reduces cost by 66.1\% and input-token usage by
	            84.7\%.},
	urldate = {2026-10-28},
	publisher = {arXiv},
	author = {Yao, Junjie and Guan, Xiongzheng and Feng, Jia and Chen, Yujia and
	          Tian, Hongliang and Gao, Cuiyun},
	month = oct,
	year = {2026},
	note = {arXiv:2610.34141 [cs.SE]},
	keywords = {Computer Science - Software Engineering},
	file = {Full Text PDF:/home/withoutdishonor/Zotero/storage/3B46JTAV/Yao et al.
	        - 2026 - SpeC2Rust Specification-Driven Repository-Level C-to-Rust
	        Translation.pdf:application/pdf;Snapshot:/home/withoutdishonor/Zotero/storage/DIAFTSM5/2610.html:text/html
	        },
}

